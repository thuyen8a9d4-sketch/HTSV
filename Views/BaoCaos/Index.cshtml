@model IEnumerable<HTSV.Models.BaoCao>

@{
    ViewData["Title"] = "Báo cáo vi phạm";
}

<div class="page-header">
    <div>
        <h1>Báo cáo vi phạm</h1>
        <div class="text-muted">Danh sách báo cáo bài đăng/bình luận vi phạm</div>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Thêm mới</a>
</div>

<div class="data-table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Lý do</th>
                <th>Trạng thái</th>
                <th>Ngày tạo</th>
                <th>Người báo cáo</th>
                <th>Bài đăng</th>
                <th>Bình luận</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
            <tr>
                <td>@item.Reason</td>
                <td>@item.Status</td>
                <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@item.ReporterUser.Username</td>
                <td>@(item.ConfessionId.HasValue ? "#" + item.ConfessionId : "-")</td>
                <td>@(item.CommentId.HasValue ? "#" + item.CommentId : "-")</td>
                <td class="row-actions">
                    <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                    <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a>
                    <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>
