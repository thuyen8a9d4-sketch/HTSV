@model HTSV.Models.BaoCao

@{
    ViewData["Title"] = "Chi tiết báo cáo";
}

<div class="page-header">
    <h1>Chi tiết báo cáo</h1>
</div>

<div class="card-surface p-4">
    <dl class="row">
        <dt class="col-sm-3">Lý do</dt>
        <dd class="col-sm-9">@Model.Reason</dd>
        <dt class="col-sm-3">Trạng thái</dt>
        <dd class="col-sm-9">@Model.Status</dd>
        <dt class="col-sm-3">Ngày tạo</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-3">Người báo cáo</dt>
        <dd class="col-sm-9">@Model.ReporterUser.Username</dd>
        <dt class="col-sm-3">Bài đăng</dt>
        <dd class="col-sm-9">@(Model.ConfessionId.HasValue ? "#" + Model.ConfessionId : "-")</dd>
        <dt class="col-sm-3">Bình luận</dt>
        <dd class="col-sm-9">@(Model.CommentId.HasValue ? "#" + Model.CommentId : "-")</dd>
    </dl>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary btn-sm">Sửa</a>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Quay lại danh sách</a>
</div>
