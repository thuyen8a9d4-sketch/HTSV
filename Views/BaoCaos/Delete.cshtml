@model HTSV.Models.BaoCao

@{
    ViewData["Title"] = "Xóa báo cáo";
}

<div class="page-header">
    <h1>Xóa báo cáo</h1>
</div>

<p class="text-danger">Bạn có chắc muốn xóa báo cáo này?</p>

<div class="card-surface p-4">
    <dl class="row">
        <dt class="col-sm-3">Lý do</dt>
        <dd class="col-sm-9">@Model.Reason</dd>
        <dt class="col-sm-3">Người báo cáo</dt>
        <dd class="col-sm-9">@Model.ReporterUser.Username</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </form>
</div>
