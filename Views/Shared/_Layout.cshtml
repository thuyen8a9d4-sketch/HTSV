@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    Func<string, string> active = (ctrl) => string.Equals(currentController, ctrl, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HTSV</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HTSV.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar" id="sidebar">
            <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">HT</span>
                <span class="brand-text">HTSV</span>
            </a>
            <nav class="sidebar-nav">
                <a class="sidebar-link @active("Home")" asp-controller="Home" asp-action="Index">
                    <span class="sidebar-icon">@await Html.PartialAsync("_Icon", "home")</span> Trang chủ
                </a>

                <div class="sidebar-group">
                    <button type="button" class="sidebar-group-toggle">
                        <span class="sidebar-icon">@await Html.PartialAsync("_Icon", "message")</span> Bài đăng
                        <span class="chevron">@await Html.PartialAsync("_Icon", "chevron-down")</span>
                    </button>
                    <div class="sidebar-submenu">
                        <a class="sidebar-sublink @active("BaiConfessions")" asp-controller="BaiConfessions" asp-action="Index">Bài đăng</a>
                        <a class="sidebar-sublink @active("DanhMucConfessions")" asp-controller="DanhMucConfessions" asp-action="Index">Danh mục</a>
                        <a class="sidebar-sublink @active("BaoCaos")" asp-controller="BaoCaos" asp-action="Index">Báo cáo vi phạm</a>
                        <a class="sidebar-sublink @active("NhatKyKiemDuyets")" asp-controller="NhatKyKiemDuyets" asp-action="Index">Nhật ký kiểm duyệt</a>
                    </div>
                </div>

                <a class="sidebar-link @active("BinhLuans")" asp-controller="BinhLuans" asp-action="Index">
                    <span class="sidebar-icon">@await Html.PartialAsync("_Icon", "flag")</span> Bình luận
                </a>

                <div class="sidebar-group">
                    <button type="button" class="sidebar-group-toggle">
                        <span class="sidebar-icon">@await Html.PartialAsync("_Icon", "book")</span> Sách
                        <span class="chevron">@await Html.PartialAsync("_Icon", "chevron-down")</span>
                    </button>
                    <div class="sidebar-submenu">
                        <a class="sidebar-sublink @active("TaiLieus")" asp-controller="TaiLieus" asp-action="Index">Sách đăng lên</a>
                        <a class="sidebar-sublink @active("PhienBanTaiLieus")" asp-controller="PhienBanTaiLieus" asp-action="Index">Phiên bản file</a>
                    </div>
                </div>

                <a class="sidebar-link @active("Revenue")" asp-controller="Revenue" asp-action="Index">
                    <span class="sidebar-icon">@await Html.PartialAsync("_Icon", "chart")</span> Kiểm toán &amp; Doanh thu
                </a>

                @if (User.IsInRole("ADMIN"))
                {
                    <div class="sidebar-group">
                        <button type="button" class="sidebar-group-toggle">
                            <span class="sidebar-icon">@await Html.PartialAsync("_Icon", "users")</span> Tài khoản &amp; Phân quyền
                            <span class="chevron">@await Html.PartialAsync("_Icon", "chevron-down")</span>
                        </button>
                        <div class="sidebar-submenu">
                            <a class="sidebar-sublink @active("NguoiDungs")" asp-controller="NguoiDungs" asp-action="Index">Tài khoản</a>
                            <a class="sidebar-sublink @active("VaiTros")" asp-controller="VaiTros" asp-action="Index">Vai trò</a>
                            <a class="sidebar-sublink @active("Quyens")" asp-controller="Quyens" asp-action="Index">Quyền</a>
                        </div>
                    </div>
                }
            </nav>
        </aside>

        <div class="app-main">
            <header class="app-header">
                <button type="button" class="sidebar-toggle-btn" id="sidebarToggle" aria-label="Toggle menu">
                    @await Html.PartialAsync("_Icon", "menu")
                </button>
                <h1 class="app-header-title">@ViewData["Title"]</h1>
                <div class="app-header-actions">
                    <span class="header-icon-btn" title="Ngôn ngữ">VN</span>
                    <span class="header-icon-btn" title="Thông báo">@await Html.PartialAsync("_Icon", "bell")</span>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="user-menu">
                            <button type="button" class="user-menu-toggle">
                                <span class="avatar-circle">@User.Identity.Name!.Substring(0, 1).ToUpper()</span>
                                <span class="user-name">@User.Identity.Name</span>
                            </button>
                            <div class="user-menu-dropdown">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="user-menu-item">Đăng xuất</button>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <a class="btn-login" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                    }
                </div>
            </header>
            <main class="app-content">
                @RenderBody()
            </main>
            <footer class="app-footer">
                &copy; 2026 - HTSV
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
