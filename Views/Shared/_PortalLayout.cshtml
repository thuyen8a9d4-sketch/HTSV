@{
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    Func<string, string> navActive = (a) => string.Equals(currentAction, a, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HTSV</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HTSV.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="portal-header">
        <div class="portal-header-inner">
            <a class="portal-brand" asp-controller="Portal" asp-action="Index">
                <span class="brand-mark">HT</span>
                <span class="brand-text">HTSV</span>
            </a>
            <nav class="portal-nav">
                <a class="portal-nav-link @navActive("Index")" asp-controller="Portal" asp-action="Index">Trang chủ</a>
                <a class="portal-nav-link @navActive("Forum") @navActive("ForumDetails") @navActive("ForumCreate")" asp-controller="Portal" asp-action="Forum">Diễn đàn</a>
                <a class="portal-nav-link @navActive("Library") @navActive("Read")" asp-controller="Portal" asp-action="Library">Thư viện</a>
            </nav>
            <form class="portal-search" asp-controller="Portal" asp-action="Library" method="get">
                <input type="text" name="q" placeholder="Tìm tài liệu..." value="@(ViewData["Query"])" />
                <button type="submit" aria-label="Tìm kiếm">@await Html.PartialAsync("_Icon", "search")</button>
            </form>
            <div class="portal-header-actions">
                <span class="header-icon-btn" title="Ngôn ngữ">VN</span>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="user-menu">
                        <button type="button" class="user-menu-toggle">
                            <span class="avatar-circle">@User.Identity.Name!.Substring(0, 1).ToUpper()</span>
                            <span class="user-name">@User.Identity.Name</span>
                        </button>
                        <div class="user-menu-dropdown">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="user-menu-item">Đăng xuất</button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a class="portal-nav-link" asp-controller="Account" asp-action="Register">Đăng ký</a>
                    <a class="btn-login" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                }
            </div>
        </div>
    </header>

    <main class="portal-content">
        @if (TempData["Message"] != null)
        {
            <div class="portal-alert">@TempData["Message"]</div>
        }
        @RenderBody()
    </main>

    <footer class="portal-footer">
        &copy; 2026 - HTSV
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
