@model HTSV.Models.BinhLuan

@{
    ViewData["Title"] = "Xóa bình luận";
}

<div class="page-header">
    <h1>Xóa bình luận</h1>
</div>

<p class="text-danger">Bạn có chắc muốn xóa bình luận này?</p>

<div class="card-surface p-4">
    <dl class="row">
        <dt class="col-sm-3">Nội dung</dt>
        <dd class="col-sm-9">@Model.Content</dd>
        <dt class="col-sm-3">Người bình luận</dt>
        <dd class="col-sm-9">@Model.AuthorUser.Username</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </form>
</div>
