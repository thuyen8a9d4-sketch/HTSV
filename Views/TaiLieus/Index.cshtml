@model IEnumerable<HTSV.Models.TaiLieu>

@{
    ViewData["Title"] = "Sách đăng lên";
}

<div class="page-header">
    <div>
        <h1>Sách đăng lên</h1>
        <div class="text-muted">Quản lý sách/tài liệu trong thư viện</div>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Đăng sách</a>
</div>

@{
    var pendingCount = Model.Count(t => t.Status == "pending");
}
@if (pendingCount > 0)
{
    <div class="portal-alert" style="background:#fff7e0;border-color:#f5d98a;color:#7a5b00;">
        Có @pendingCount giáo trình do giảng viên gửi lên đang chờ duyệt.
    </div>
}

<div class="data-table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Tiêu đề</th>
                <th>Loại</th>
                <th>Miễn phí</th>
                <th>Giá</th>
                <th>Trạng thái</th>
                <th>Người đăng</th>
                <th>Ngày đăng</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
            <tr>
                <td>@item.Title</td>
                <td>@item.Type</td>
                <td>@(item.IsFree ? "Có" : "Không")</td>
                <td>@(item.Price.HasValue ? item.Price.Value.ToString("N0") + " đ" : "-")</td>
                <td>
                    @if (item.Status == "pending")
                    {
                        <span class="library-badge paid">Chờ duyệt</span>
                    }
                    else if (item.Status == "published")
                    {
                        <span class="library-badge free">Đã duyệt</span>
                    }
                    else
                    {
                        @item.Status
                    }
                </td>
                <td>@item.OwnerUser.Username</td>
                <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                <td class="row-actions">
                    <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                    <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a>
                    <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>
