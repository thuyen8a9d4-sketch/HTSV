@model HTSV.Models.TaiLieu

@{
    ViewData["Title"] = "Chi tiết sách";
}

<div class="page-header">
    <h1>@Model.Title</h1>
</div>

<div class="card-surface p-4">
    <dl class="row">
        <dt class="col-sm-3">Loại</dt>
        <dd class="col-sm-9">@Model.Type</dd>
        <dt class="col-sm-3">Mô tả</dt>
        <dd class="col-sm-9">@Model.Description</dd>
        <dt class="col-sm-3">Miễn phí</dt>
        <dd class="col-sm-9">@(Model.IsFree ? "Có" : "Không")</dd>
        <dt class="col-sm-3">Có bán</dt>
        <dd class="col-sm-9">@(Model.IsSellable ? "Có" : "Không")</dd>
        <dt class="col-sm-3">Giá</dt>
        <dd class="col-sm-9">@(Model.Price.HasValue ? Model.Price.Value.ToString("N0") + " đ" : "-")</dd>
        <dt class="col-sm-3">Trạng thái</dt>
        <dd class="col-sm-9">@Model.Status</dd>
        <dt class="col-sm-3">Ngày đăng</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-3">Người đăng</dt>
        <dd class="col-sm-9">@Model.OwnerUser.Username (@Model.OwnerUser.FullName)</dd>
    </dl>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary btn-sm">Sửa</a>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Quay lại danh sách</a>
</div>
