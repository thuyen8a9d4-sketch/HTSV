@model HTSV.Models.TaiLieu

@{
    ViewData["Title"] = "Đăng sách";
}

<div class="page-header">
    <h1>Đăng sách mới</h1>
</div>

<div class="form-card">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="OwnerUserId">Người đăng</label>
            <select asp-for="OwnerUserId" class="form-control" asp-items="ViewBag.OwnerUserId"></select>
        </div>
        <div class="form-group">
            <label asp-for="Type">Loại</label>
            <input asp-for="Type" class="form-control" placeholder="SLIDE / LESSON_PLAN / TEXTBOOK / OTHER" />
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Title">Tiêu đề</label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Description">Mô tả</label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="form-group form-check">
            <input class="form-check-input" asp-for="IsFree" />
            <label class="form-check-label" asp-for="IsFree">Miễn phí</label>
        </div>
        <div class="form-group form-check">
            <input class="form-check-input" asp-for="IsSellable" />
            <label class="form-check-label" asp-for="IsSellable">Có bán</label>
        </div>
        <div class="form-group">
            <label asp-for="Price">Giá (đ)</label>
            <input asp-for="Price" class="form-control" />
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Status">Trạng thái</label>
            <input asp-for="Status" class="form-control" placeholder="published / draft" />
        </div>
        <div class="form-group">
            <label asp-for="CreatedAt">Ngày đăng</label>
            <input asp-for="CreatedAt" class="form-control" />
        </div>
        <div class="form-group">
            <input type="submit" value="Lưu" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
