@model HTSV.Models.TaiLieu

@{
    ViewData["Title"] = "Xóa sách";
}

<div class="page-header">
    <h1>Xóa sách</h1>
</div>

<p class="text-danger">Bạn có chắc muốn xóa sách này?</p>

<div class="card-surface p-4">
    <dl class="row">
        <dt class="col-sm-3">Tiêu đề</dt>
        <dd class="col-sm-9">@Model.Title</dd>
        <dt class="col-sm-3">Loại</dt>
        <dd class="col-sm-9">@Model.Type</dd>
        <dt class="col-sm-3">Giá</dt>
        <dd class="col-sm-9">@(Model.IsFree ? "Miễn phí" : (Model.Price.HasValue ? Model.Price.Value.ToString("N0") + " đ" : "-"))</dd>
        <dt class="col-sm-3">Người đăng</dt>
        <dd class="col-sm-9">@Model.OwnerUser.Username</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </form>
</div>
