@model HTSV.Controllers.ScheduleViewModel
@{
    ViewData["Title"] = "Lịch học";
    string[] dowLabels = { "T2", "T3", "T4", "T5", "T6", "T7", "CN" };
    var prevWeek = Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd");
    var nextWeek = Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd");
    var todayStr = Model.Today.ToString("yyyy-MM-dd");
}

<div class="page-header">
    <div>
        <h1>Lịch học</h1>
        <div class="text-muted">Tuần @Model.WeekStart.ToString("dd/MM") &ndash; @Model.WeekEnd.ToString("dd/MM/yyyy")</div>
    </div>
</div>

<div class="schedule-toolbar">
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-week="@todayStr">Hôm nay</a>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-week="@prevWeek">&lsaquo;</a>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index" asp-route-week="@nextWeek">&rsaquo;</a>
    <span class="schedule-range">@Model.WeekStart.ToString("dd/MM") &ndash; @Model.WeekEnd.ToString("dd/MM")</span>
</div>

<div class="schedule-grid">
    @for (int i = 0; i < Model.Days.Count; i++)
    {
        var day = Model.Days[i];
        var isToday = day.Date == Model.Today;
        <div class="schedule-day @(isToday ? "is-today" : "")">
            <div class="schedule-day-head">
                <div class="dow">@dowLabels[i]</div>
                <div class="dom">@day.Date.ToString("dd/MM")</div>
            </div>
            <div class="schedule-day-body">
                @if (day.Sessions.Count == 0)
                {
                    <div class="schedule-day-empty">Không có lịch</div>
                }
                else
                {
                    @foreach (var s in day.Sessions)
                    {
                        <div class="schedule-session">
                            <div class="session-subject">@s.Course.Subject.Name</div>
                            <div class="session-meta">Buổi @s.LessonNo &middot; @s.Title</div>
                            <div class="session-meta">GV: @s.Course.Lecturer.User.FullName</div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>
