@{
    ViewData["Title"] = "Trang chủ";
    Layout = "_PortalLayout";
}

<div class="portal-hero">
    <h1>Cộng đồng HTSV</h1>
    <p>Diễn đàn trao đổi, chia sẻ và thư viện tài liệu học tập của sinh viên trường.</p>
    <a class="btn" asp-controller="Portal" asp-action="Forum">Xem diễn đàn</a>
</div>

<div class="quick-links">
    <a class="quick-link-card" asp-controller="Portal" asp-action="Forum">
        <span class="quick-link-icon">@await Html.PartialAsync("_Icon", "message")</span>
        <span>
            <div class="quick-link-title">Diễn đàn</div>
            <div class="quick-link-sub">Xem, đăng và bình luận bài viết</div>
        </span>
    </a>
    <a class="quick-link-card" asp-controller="Portal" asp-action="Library">
        <span class="quick-link-icon">@await Html.PartialAsync("_Icon", "file")</span>
        <span>
            <div class="quick-link-title">Thư viện</div>
            <div class="quick-link-sub">Tìm và đọc tài liệu học tập</div>
        </span>
    </a>
</div>
