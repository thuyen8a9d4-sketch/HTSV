@model IEnumerable<HTSV.Models.BaiConfession>
@{
    ViewData["Title"] = "Diễn đàn";
    Layout = "_PortalLayout";
    bool isLoggedIn = User.Identity != null && User.Identity.IsAuthenticated;
}

<div class="page-header">
    <div>
        <h1>Diễn đàn</h1>
        <div class="text-muted">Chia sẻ, trao đổi trong cộng đồng sinh viên</div>
    </div>
    @if (isLoggedIn)
    {
        <a asp-action="ForumCreate" class="btn btn-primary">+ Đăng bài</a>
    }
</div>

@if (!isLoggedIn)
{
    <div class="portal-alert" style="background:#fff7e0;border-color:#f5d98a;color:#7a5b00;">
        Bạn đang xem ở chế độ khách &ndash; chỉ có thể xem bài viết. <a asp-controller="Account" asp-action="Login">Đăng nhập</a> để đăng bài, bình luận và thích.
    </div>
}

@if (!Model.Any())
{
    <p class="text-muted">Chưa có bài viết nào được duyệt.</p>
}

@foreach (var post in Model)
{
    <div class="forum-post">
        <div class="forum-post-author">@(post.IsAnonymous ? "Ẩn danh" : post.AuthorUser.FullName)</div>
        <div class="forum-post-meta">@post.CreatedAt.ToString("dd/MM/yyyy HH:mm") @(post.Category != null ? "· " + post.Category.Name : "")</div>
        <div class="forum-post-content">@(post.Content.Length > 240 ? post.Content.Substring(0, 240) + "..." : post.Content)</div>
        <div class="forum-post-actions">
            <span>@await Html.PartialAsync("_Icon", "heart") @post.LuotThiches.Count</span>
            <a asp-action="ForumDetails" asp-route-id="@post.Id">@await Html.PartialAsync("_Icon", "message") @post.BinhLuans.Count bình luận</a>
        </div>
    </div>
}
