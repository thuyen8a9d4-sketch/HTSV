@{
    ViewData["Title"] = "Đăng bài";
    Layout = "_PortalLayout";
}

<div class="page-header">
    <h1>Đăng bài viết</h1>
</div>

<div class="form-card">
    <form asp-action="ForumCreate" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label>Nội dung</label>
            <textarea name="content" class="form-control" rows="5" required></textarea>
        </div>
        <div class="form-group form-check">
            <input type="checkbox" name="isAnonymous" value="true" class="form-check-input" id="isAnonymous" />
            <label class="form-check-label" for="isAnonymous">Đăng ẩn danh</label>
        </div>
        <div class="form-group">
            <button type="submit" class="btn btn-primary">Gửi bài (chờ duyệt)</button>
            <a asp-action="Forum" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </form>
</div>
