@model IEnumerable<HTSV.Models.TaiLieu>
@{
    ViewData["Title"] = "Giáo trình của tôi";
    Layout = "_PortalLayout";
}

<div class="page-header">
    <div>
        <h1>Giáo trình của tôi</h1>
        <div class="text-muted">Theo dõi trạng thái duyệt và giá bán</div>
    </div>
    <a asp-action="UploadMaterial" class="btn btn-primary">+ Đăng giáo trình</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Bạn chưa đăng giáo trình nào.</p>
}

<div class="data-table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Tiêu đề</th>
                <th>Loại</th>
                <th>Trạng thái</th>
                <th>Giá</th>
                <th>Ngày gửi</th>
            </tr>
        </thead>
        <tbody>
@foreach (var doc in Model)
{
            <tr>
                <td>@doc.Title</td>
                <td>@doc.Type</td>
                <td>
                    @if (doc.Status == "published")
                    {
                        <span class="library-badge free">Đã duyệt</span>
                    }
                    else if (doc.Status == "pending")
                    {
                        <span class="library-badge paid">Chờ duyệt</span>
                    }
                    else
                    {
                        @doc.Status
                    }
                </td>
                <td>@(doc.IsFree ? "Miễn phí" : (doc.Price.HasValue ? doc.Price.Value.ToString("N0") + " đ" : "Chưa định giá"))</td>
                <td>@doc.CreatedAt.ToString("dd/MM/yyyy")</td>
            </tr>
}
        </tbody>
    </table>
</div>
