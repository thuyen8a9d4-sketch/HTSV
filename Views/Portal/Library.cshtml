@model IEnumerable<HTSV.Models.TaiLieu>
@{
    ViewData["Title"] = "Thư viện";
    Layout = "_PortalLayout";
    var query = ViewData["Query"] as string;
}

<div class="page-header">
    <div>
        <h1>Thư viện tài liệu</h1>
        <div class="text-muted">@(string.IsNullOrEmpty(query) ? "Tất cả tài liệu" : $"Kết quả tìm kiếm cho \"{query}\"")</div>
    </div>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Không tìm thấy tài liệu nào.</p>
}

<div class="library-grid">
@foreach (var doc in Model)
{
    <div class="library-card">
        <span class="library-badge @(doc.IsFree ? "free" : "paid")">@(doc.IsFree ? "Miễn phí" : (doc.Price.HasValue ? doc.Price.Value.ToString("N0") + " đ" : "Có phí"))</span>
        <div class="library-card-title">@doc.Title</div>
        <div class="library-card-subject">@doc.Type</div>
        <a asp-action="Read" asp-route-id="@doc.Id" class="btn btn-outline-secondary btn-sm mt-2">Xem chi tiết</a>
    </div>
}
</div>
