@model IEnumerable<HTSV.Models.PhienBanTaiLieu>

@{
    ViewData["Title"] = "Phiên bản file";
}

<div class="page-header">
    <div>
        <h1>Phiên bản file</h1>
        <div class="text-muted">Quản lý file đính kèm cho sách</div>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Thêm mới</a>
</div>

<div class="data-table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Sách</th>
                <th>Số phiên bản</th>
                <th>Đường dẫn file</th>
                <th>Dung lượng</th>
                <th>Loại file</th>
                <th>Số trang</th>
                <th>Ngày tải lên</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
            <tr>
                <td>@item.Material.Title</td>
                <td>@item.VersionNo</td>
                <td>@item.FilePath</td>
                <td>@(item.FileSize.HasValue ? (item.FileSize.Value / 1024) + " KB" : "-")</td>
                <td>@item.MimeType</td>
                <td>@item.PageCount</td>
                <td>@item.UploadedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td class="row-actions">
                    <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                    <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a>
                    <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>
