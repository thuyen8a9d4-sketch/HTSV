@model HTSV.Models.PhienBanTaiLieu

@{
    ViewData["Title"] = "Chi tiết phiên bản file";
}

<div class="page-header">
    <h1>Chi tiết phiên bản file</h1>
</div>

<div class="card-surface p-4">
    <dl class="row">
        <dt class="col-sm-3">Sách</dt>
        <dd class="col-sm-9">@Model.Material.Title</dd>
        <dt class="col-sm-3">Số phiên bản</dt>
        <dd class="col-sm-9">@Model.VersionNo</dd>
        <dt class="col-sm-3">Đường dẫn file</dt>
        <dd class="col-sm-9">@Model.FilePath</dd>
        <dt class="col-sm-3">Dung lượng</dt>
        <dd class="col-sm-9">@(Model.FileSize.HasValue ? (Model.FileSize.Value / 1024) + " KB" : "-")</dd>
        <dt class="col-sm-3">Loại file</dt>
        <dd class="col-sm-9">@Model.MimeType</dd>
        <dt class="col-sm-3">Số trang</dt>
        <dd class="col-sm-9">@Model.PageCount</dd>
        <dt class="col-sm-3">Ngày tải lên</dt>
        <dd class="col-sm-9">@Model.UploadedAt.ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary btn-sm">Sửa</a>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Quay lại danh sách</a>
</div>
