@model HTSV.Models.PhienBanTaiLieu

@{
    ViewData["Title"] = "Xóa phiên bản file";
}

<div class="page-header">
    <h1>Xóa phiên bản file</h1>
</div>

<p class="text-danger">Bạn có chắc muốn xóa phiên bản file này?</p>

<div class="card-surface p-4">
    <dl class="row">
        <dt class="col-sm-3">Sách</dt>
        <dd class="col-sm-9">@Model.Material.Title</dd>
        <dt class="col-sm-3">Đường dẫn file</dt>
        <dd class="col-sm-9">@Model.FilePath</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </form>
</div>
