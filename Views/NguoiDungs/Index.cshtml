@model IEnumerable<HTSV.Models.NguoiDung>

@{
    ViewData["Title"] = "Tài khoản";
}

<div class="page-header">
    <div>
        <h1>Tài khoản</h1>
        <div class="text-muted">Quản lý tài khoản người dùng</div>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Thêm mới</a>
</div>

<div class="data-table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Tên đăng nhập</th>
                <th>Email</th>
                <th>Họ tên</th>
                <th>Đang hoạt động</th>
                <th>Ngày tạo</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
            <tr>
                <td>@item.Username</td>
                <td>@item.Email</td>
                <td>@item.FullName</td>
                <td>@(item.IsActive ? "Có" : "Không")</td>
                <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                <td class="row-actions">
                    <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                    <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a>
                    <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>
