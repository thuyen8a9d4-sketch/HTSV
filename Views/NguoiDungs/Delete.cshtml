@model HTSV.Models.NguoiDung

@{
    ViewData["Title"] = "Xóa tài khoản";
}

<div class="page-header">
    <h1>Xóa tài khoản</h1>
</div>

<p class="text-danger">Bạn có chắc muốn xóa tài khoản này?</p>

<div class="card-surface p-4">
    <dl class="row">
        <dt class="col-sm-3">Tên đăng nhập</dt>
        <dd class="col-sm-9">@Model.Username</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Họ tên</dt>
        <dd class="col-sm-9">@Model.FullName</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </form>
</div>
