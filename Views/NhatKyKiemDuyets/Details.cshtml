@model HTSV.Models.NhatKyKiemDuyet

@{
    ViewData["Title"] = "Chi tiết nhật ký kiểm duyệt";
}

<div class="page-header">
    <h1>Chi tiết nhật ký kiểm duyệt</h1>
</div>

<div class="card-surface p-4">
    <dl class="row">
        <dt class="col-sm-3">Bài đăng</dt>
        <dd class="col-sm-9">#@Model.ConfessionId</dd>
        <dt class="col-sm-3">Người kiểm duyệt</dt>
        <dd class="col-sm-9">@Model.ModeratorUser.Username</dd>
        <dt class="col-sm-3">Hành động</dt>
        <dd class="col-sm-9">@Model.Action</dd>
        <dt class="col-sm-3">Trạng thái cũ</dt>
        <dd class="col-sm-9">@Model.OldStatus</dd>
        <dt class="col-sm-3">Trạng thái mới</dt>
        <dd class="col-sm-9">@Model.NewStatus</dd>
        <dt class="col-sm-3">Ghi chú</dt>
        <dd class="col-sm-9">@Model.Note</dd>
        <dt class="col-sm-3">Ngày tạo</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary btn-sm">Sửa</a>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Quay lại danh sách</a>
</div>
