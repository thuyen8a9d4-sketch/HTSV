@model HTSV.Models.NhatKyKiemDuyet

@{
    ViewData["Title"] = "Xóa nhật ký kiểm duyệt";
}

<div class="page-header">
    <h1>Xóa nhật ký kiểm duyệt</h1>
</div>

<p class="text-danger">Bạn có chắc muốn xóa mục này?</p>

<div class="card-surface p-4">
    <dl class="row">
        <dt class="col-sm-3">Bài đăng</dt>
        <dd class="col-sm-9">#@Model.ConfessionId</dd>
        <dt class="col-sm-3">Hành động</dt>
        <dd class="col-sm-9">@Model.Action</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </form>
</div>
