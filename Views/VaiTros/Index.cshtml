@model IEnumerable<HTSV.Models.VaiTro>

@{
    ViewData["Title"] = "Vai trò";
}

<div class="page-header">
    <div>
        <h1>Vai trò</h1>
        <div class="text-muted">Quản lý vai trò trong hệ thống</div>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Thêm mới</a>
</div>

<div class="data-table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Mã</th>
                <th>Tên</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
            <tr>
                <td>@item.Code</td>
                <td>@item.Name</td>
                <td class="row-actions">
                    <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                    <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a>
                    <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>
