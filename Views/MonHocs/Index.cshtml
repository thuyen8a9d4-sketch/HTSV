@model IEnumerable<HTSV.Models.MonHoc>

@{
    ViewData["Title"] = "Môn học";
}

<div class="page-header">
    <div>
        <h1>Môn học</h1>
        <div class="text-muted">Danh sách môn học trong chương trình đào tạo</div>
    </div>
    <a asp-action="Create" class="btn btn-primary">+ Thêm môn học</a>
</div>

<div class="data-table-card">
    <table class="data-table">
        <thead>
            <tr>
                <th>Mã môn</th>
                <th>Tên môn học</th>
                <th>Mô tả</th>
                <th>Số tín chỉ</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Code)</td>
                <td>@Html.DisplayFor(modelItem => item.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Description)</td>
                <td>@Html.DisplayFor(modelItem => item.Credits)</td>
                <td class="row-actions">
                    <a asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                    <a asp-action="Details" asp-route-id="@item.Id">Chi tiết</a>
                    <a asp-action="Delete" asp-route-id="@item.Id">Xóa</a>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>
