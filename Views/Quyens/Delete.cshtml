@model HTSV.Models.Quyen

@{
    ViewData["Title"] = "Xóa quyền";
}

<div class="page-header">
    <h1>Xóa quyền</h1>
</div>

<p class="text-danger">Bạn có chắc muốn xóa quyền này?</p>

<div class="card-surface p-4">
    <dl class="row">
        <dt class="col-sm-3">Mã</dt>
        <dd class="col-sm-9">@Model.Code</dd>
        <dt class="col-sm-3">Tên</dt>
        <dd class="col-sm-9">@Model.Name</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </form>
</div>
