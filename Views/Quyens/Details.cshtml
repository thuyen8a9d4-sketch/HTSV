@model HTSV.Models.Quyen

@{
    ViewData["Title"] = "Chi tiết quyền";
}

<div class="page-header">
    <h1>Chi tiết quyền</h1>
</div>

<div class="card-surface p-4">
    <dl class="row">
        <dt class="col-sm-3">Mã</dt>
        <dd class="col-sm-9">@Model.Code</dd>
        <dt class="col-sm-3">Tên</dt>
        <dd class="col-sm-9">@Model.Name</dd>
        <dt class="col-sm-3">Mô tả</dt>
        <dd class="col-sm-9">@Model.Description</dd>
    </dl>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary btn-sm">Sửa</a>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Quay lại danh sách</a>
</div>
