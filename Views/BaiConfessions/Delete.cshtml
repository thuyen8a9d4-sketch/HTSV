@model HTSV.Models.BaiConfession

@{
    ViewData["Title"] = "Xóa bài đăng";
}

<div class="page-header">
    <h1>Xóa bài đăng</h1>
</div>

<p class="text-danger">Bạn có chắc muốn xóa bài đăng này?</p>

<div class="card-surface p-4">
    <dl class="row">
        <dt class="col-sm-3">Nội dung</dt>
        <dd class="col-sm-9">@Model.Content</dd>
        <dt class="col-sm-3">Trạng thái</dt>
        <dd class="col-sm-9">@Model.Status</dd>
        <dt class="col-sm-3">Người đăng</dt>
        <dd class="col-sm-9">@Model.AuthorUser.Username</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Xóa" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </form>
</div>
