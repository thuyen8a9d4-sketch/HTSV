@model HTSV.Models.BaiConfession

@{
    ViewData["Title"] = "Chi tiết bài đăng";
}

<div class="page-header">
    <h1>Chi tiết bài đăng</h1>
</div>

<div class="card-surface p-4">
    <dl class="row">
        <dt class="col-sm-3">Nội dung</dt>
        <dd class="col-sm-9">@Model.Content</dd>
        <dt class="col-sm-3">Ẩn danh</dt>
        <dd class="col-sm-9">@(Model.IsAnonymous ? "Có" : "Không")</dd>
        <dt class="col-sm-3">Trạng thái</dt>
        <dd class="col-sm-9">@Model.Status</dd>
        <dt class="col-sm-3">Lý do từ chối</dt>
        <dd class="col-sm-9">@Model.RejectReason</dd>
        <dt class="col-sm-3">Ngày tạo</dt>
        <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-3">Ngày duyệt</dt>
        <dd class="col-sm-9">@(Model.ApprovedAt?.ToString("dd/MM/yyyy HH:mm"))</dd>
        <dt class="col-sm-3">Người duyệt (Id)</dt>
        <dd class="col-sm-9">@Model.ApprovedByUserId</dd>
        <dt class="col-sm-3">Người đăng</dt>
        <dd class="col-sm-9">@Model.AuthorUser.Username</dd>
        <dt class="col-sm-3">Danh mục</dt>
        <dd class="col-sm-9">@Model.Category?.Name</dd>
    </dl>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary btn-sm">Sửa</a>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Quay lại danh sách</a>
</div>
