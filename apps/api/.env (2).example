NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

CORE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=no-verify

JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=30d

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_FROM=your-email@gmail.com
MAIL_PASSWORD=
MAIL_DISPLAY_NAME=HTSV

ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@htsv.local
ADMIN_SEED_PASSWORD=Admin@123

# Google OAuth app: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Facebook Login app: https://developers.facebook.com/apps
# Valid OAuth Redirect URI must match FACEBOOK_CALLBACK_URL exactly.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback
FRONTEND_ORIGIN=http://localhost:5173
CORE_DATABASE_URL="postgresql://postgres:123456@localhost:5432/htsv_db?schema=public"
JWT_ACCESS_SECRET=super_secret_access_key_123
JWT_REFRESH_SECRET=super_secret_refresh_key_123
MAIL_HOST=smtp.gmail.com
MAIL_FROM=noreply@example.com